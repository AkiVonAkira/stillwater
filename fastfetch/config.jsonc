// Stillwater fastfetch. kayzel. @version 1.0.0
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "color": {
      "keys": "38;2;90;168;180"
    },
    "key": {
      "width": 9
    },
    "separator": "  ",
    "percent": {
      "type": 9,
      "color": {
        "green": "38;2;142;192;124",
        "yellow": "38;2;217;198;121",
        "red": "38;2;244;71;71"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "\u001b[1;38;2;235;219;178m{user-name}\u001b[0m\u001b[38;2;143;143;153m @ \u001b[0m\u001b[1;38;2;235;219;178m{host-name}\u001b[0m"
    },
    {
      "type": "command",
      "key": " ",
      "keyWidth": 1,
      "text": ". /etc/os-release 2>/dev/null; n=\"${NAME:-Linux}\"; seal=\"\"; if command -v ryoku >/dev/null 2>&1; then n=Ryoku; seal=\" · 力\"; fi; c=\"$(hostnamectl chassis 2>/dev/null)\"; up() { printf '%s' \"$1\" | tr '[:lower:]' '[:upper:]'; }; printf '\u001b[38;2;90;168;180m■\u001b[0m \u001b[38;2;143;143;153m%s%s%s\u001b[0m' \"$(up \"$n\")\" \"$seal\" \"${c:+ · $(up \"$c\")}\""
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;196;164;137m──\u001b[0m \u001b[1;38;2;235;219;178mVITALS\u001b[0m \u001b[38;2;60;56;54m────────────────────────\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "detectionMethod": "pci"
    },
    {
      "type": "memory",
      "key": "MEMORY"
    },
    {
      "type": "disk",
      "key": "DISK",
      "folders": "/"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;196;164;137m──\u001b[0m \u001b[1;38;2;235;219;178mSYSTEM\u001b[0m \u001b[38;2;60;56;54m────────────────────────\u001b[0m"
    },
    {
      "type": "command",
      "key": "OS",
      "text": "if command -v ryoku >/dev/null 2>&1; then echo \"Ryoku $(ryoku version --pretty 2>/dev/null)\"; else . /etc/os-release && echo \"$PRETTY_NAME\"; fi"
    },
    {
      "type": "command",
      "key": "BRANCH",
      "text": "ryoku version --branch 2>/dev/null"
    },
    {
      "type": "kernel",
      "key": "KERNEL"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "command",
      "key": "SHELL",
      "text": "basename \"${SHELL:-unknown}\""
    },
    {
      "type": "packages",
      "key": "PKGS"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;196;164;137m──\u001b[0m \u001b[1;38;2;235;219;178mSESSION\u001b[0m \u001b[38;2;60;56;54m───────────────────────\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    },
    {
      "type": "command",
      "key": "AGE",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "terminal",
      "key": "TERM"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}
