{
  "name": "Stillwater",
  "globals": {
    "background": "#1d2021",
    "foreground": "#ebdbb2",
    "caret": "#5aa8b4",
    "block_caret": "#5aa8b4",
    "line_highlight": "#222526",
    "selection": "#3a4e64",
    "selection_border": "#5aa8b4",
    "inactive_selection": "#3a4e6480",
    "inactive_selection_border": "#3c3836",
    "misspelling": "#f44747",
    "shadow": "#1a1c1d",
    "accent": "#5aa8b4",
    "gutter": "#1d2021",
    "gutter_foreground": "#8f8f99",
    "guide": "#3c3836",
    "active_guide": "#5aa8b4",
    "brackets_options": "underline",
    "brackets_foreground": "#5aa8b4",
    "bracket_contents_options": "underline",
    "bracket_contents_foreground": "#6ebcc6",
    "tags_options": "stippled_underline",
    "tags_foreground": "#5aa8b4",
    "highlight": "#5aa8b4",
    "find_highlight": "#3d7a88",
    "find_highlight_foreground": "#ebdbb2",
    "fold_marker": "#8f8f99",
    "minimap_border": "#3c3836",
    "line_diff_width": "2",
    "line_diff_added": "#A6E22E",
    "line_diff_modified": "#d9c679",
    "line_diff_deleted": "#f44747"
  },
  "rules": [
    { "name": "Comment", "scope": "comment", "foreground": "#88846F", "font_style": "italic" },
    { "name": "String", "scope": "string", "foreground": "#E6DB74" },
    { "name": "Number", "scope": "constant.numeric", "foreground": "#AE81FF" },
    { "name": "Constant", "scope": "constant", "foreground": "#AE81FF" },
    { "name": "Keyword", "scope": "keyword, storage", "foreground": "#F92672" },
    { "name": "Storage type", "scope": "storage.type", "foreground": "#66D9EF" },
    { "name": "Function", "scope": "entity.name.function, support.function", "foreground": "#A6E22E" },
    { "name": "Type", "scope": "entity.name.type, entity.name.class, support.type, support.class", "foreground": "#A6E22E" },
    { "name": "Variable", "scope": "variable", "foreground": "#F8F8F2" },
    { "name": "Parameter", "scope": "variable.parameter", "foreground": "#FD971F" },
    { "name": "Tag", "scope": "entity.name.tag", "foreground": "#F92672" },
    { "name": "Attribute", "scope": "entity.other.attribute-name", "foreground": "#A6E22E" },
    { "name": "Invalid", "scope": "invalid", "foreground": "#F44747" },
    { "name": "Markup heading", "scope": "markup.heading", "foreground": "#A6E22E" },
    { "name": "Markup link", "scope": "markup.underline.link", "foreground": "#5aa8b4" }
  ]
}
